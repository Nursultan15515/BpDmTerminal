<h1>Give card page</h1>

<script>

    let pendingOpId = null;
    let pendingUid = null;

    document.getElementById("loaderId").style.display = "flex";

    fetch("http://localhost:8080/issue-card/", { method: "POST" })
        .then(r => r.json())
        .then(data => {
            if (data.success) {

                pendingOpId = data.operationId;
                pendingUid = data.uid;

                setVisitorsRFID('@ViewBag.passCardVisitorId', encodeURIComponent(data.uid));

            } else {
                window.location.href = "/Home/ErrorPage";
            }
        });

    function setVisitorsRFID(passCardVisitorId, rfidNumber) {

        fetch(`/Home/SetVisitorsRFID?passCardVisitorId=${passCardVisitorId}&rfidNumber=${rfidNumber}`, { method: "POST" })
        .then(r => r.json())
        .then(data => {
            console.log('setVisitorsRFID data=', data);

            if (data.status == true) {
                takeOrReturnCard(true);
            }
            else
            {
                takeOrReturnCard(false);
            }
        })
    }

    function takeOrReturnCard(allow = false) {
        fetch("http://localhost:8080/confirm/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ operationId: pendingOpId, allow })
        })
            .then(r => r.json())
            .then(data => {
                console.log("confirm →", data);
                if (!data || data.error) {
                    alert("Ошибка при выдаче карт: " + (data && data.error));
                    return;
                }

                //alert(`OK: ${data.action} (uid=${data.uid || pendingUid || "-"})`);
            })
            .catch(err => {
                alert(err);
            })
            .finally(() => {
                // очищаем состояние
                pendingOpId = null;
                pendingUid = null;

                if (allow === true) {
                    window.location.href = "/Home/OfferTakeСard";
                } else {
                    window.location.href = "/Home/ErrorPage";
                }
            });
    }
</script>